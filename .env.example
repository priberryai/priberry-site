# Build-time variables (Cloudflare Pages > Settings > Variables, "Production" and "Preview").
# NEXT_PUBLIC_* values are baked into the static site and are public by design.

# Cloudflare Turnstile site key (public). Local dev falls back to Cloudflare's always-pass test key.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Cloudflare Web Analytics token (public). Leave empty to disable analytics.
NEXT_PUBLIC_CF_BEACON_TOKEN=

# Runtime secrets for the Pages Function (functions/api/pilot.ts).
# Set these as encrypted secrets in Cloudflare Pages; for `wrangler pages dev`, put them in .dev.vars.
TURNSTILE_SECRET_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
